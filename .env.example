# ============================================================
# FoodResQ Server — Environment Variables
# Copy this file to server/.env and fill in the values.
# NEVER commit your actual .env file to Git!
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local:  mongodb://localhost:27017/foodresq
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/foodresq
MONGODB_URI=mongodb://localhost:27017/foodresq

# ---- JWT ----
# Generate a long random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# ---- CORS ----
# For production, set to your Vercel frontend URL (comma-separated for multiple)
# Example: https://foodresq.vercel.app,https://foodresq-preview.vercel.app
CORS_ORIGIN=http://localhost:5173

# ---- Gemini AI API (for real AI integration — optional for simulated mode) ----
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- File Uploads ----
# Max file size in MB for food images
MAX_FILE_SIZE=10
