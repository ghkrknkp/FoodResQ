{
  "name": "foodresq",
  "version": "1.0.0",
  "description": "Food Surplus Redistribution Platform - Connecting food providers with NGOs and volunteers",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "keywords": [
    "food-waste",
    "redistribution",
    "social-impact",
    "mern",
    "socket-io"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
